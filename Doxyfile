# Doxygen 配置文件
#
# 用法：
#   doxygen Doxyfile
# 或在 CMake 构建目录中执行：
#   make docs
#
# 生成的 HTML 文档位于 docs/doxygen/html/index.html。

PROJECT_NAME           = "Validate Kalman Filter"
PROJECT_BRIEF          = "通过可配置的仿真真值验证自瞄 EKF 模型与参数"
PROJECT_NUMBER         = "2.0"

OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = README.md tools tasks tests
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES

HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
